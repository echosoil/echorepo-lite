# ============================================================
# Zenodo biodiversity version state
# ============================================================

# IMPORTANT:
# Do NOT use the canonical ECHOREPO deposition ID here.
#
# For the FIRST biodiversity publication there is no
# ZENODO_DEPOSITION_ID yet.
#
# After the first successful publication, the update script
# should read the latest biodiversity deposition ID from this
# state file.

ZENODO_DEPOSITION_STATE_FILE=data/zenodo_biodiversity_latest_deposition_id.txt

# Optional bootstrap fallback for update_biodiversity_zenodo.sh.
# Set this ONLY after the first biodiversity record has been
# published, if the state file does not yet exist.
#
# ZENODO_DEPOSITION_ID=12345678


# ============================================================
# Zenodo record metadata
# ============================================================

ZENODO_TITLE="ECHOREPO Microbial Biodiversity Source Data"

ZENODO_DESCRIPTION="OTU/feature-level microbial biodiversity data associated with ECHOREPO soil samples. The dataset preserves source taxonomy, sample-to-marker associations, and sparse non-zero sequence-read abundances for 16S and ITS marker datasets. It complements the canonical ECHOREPO Soil Dataset, where biodiversity data are provided as compact taxonomic abundance statistics."

ZENODO_CREATOR="Osychenko, Oleg|Quanta Systems, S.L.|0000-0003-3468-6824"

ZENODO_GRANT=101112869

ZENODO_COPYRIGHT="© 2026 ECHO Horizon Project"

ZENODO_KEYWORD="soil,biodiversity,microbial-biodiversity,16S,ITS,OTU,taxonomy,soil-biodiversity,citizen-science"

# Keep the already-used verified subject for now.
# Do not use Markdown syntax here.
ZENODO_SUBJECT="Soil science|http://id.loc.gov/authorities/subjects/sh85124022|url"

ZENODO_LOG_FILE=data/zenodo_biodiversity_sync_log.csv


# ============================================================
# CSVW / machine-readable metadata configuration
# ============================================================

SOILWISE_METADATA_CONFIG=metadata/biodiversity/echorepo_biodiversity_columns.json

SOILWISE_FILE_JSON_NAME=file.json

# For the first biodiversity publication I recommend leaving
# SoilVoc validation disabled until the biodiversity metadata
# configuration itself has been tested.
SOILWISE_VALIDATE=false

SOILWISE_REQUIRE_VALIDATION=false
SOILWISE_REQUIRE_COMPLETE_METADATA=false


# ============================================================
# Source archive
# ============================================================

# false:
#   upload the individual biodiversity CSV files + file.json
#
# true:
#   additionally upload the downloaded biodiversity_raw.zip
#   as a convenience/archive file

ZENODO_KEEP_SOURCE_ARCHIVE=false