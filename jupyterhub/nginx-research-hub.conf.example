# Add to the externally managed HTTPS Nginx vhost. Pilot URL only.
# NEVER expose :8890 to the Internet or to untrusted clients: the Hub
# trusts the X-ECHOREPO-User header. Strip any client-supplied copy.
location = /__jupyterhub_auth {
    internal;
    proxy_pass http://172.31.5.252:8001/internal/jupyterhub-auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host echorepo.quanta-labs.com;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Forwarded-Proto https;
    proxy_cache off;
}

location @jupyterhub_login {
    return 302 /login?next=$uri;
}

location = /research/hub { return 301 /research/hub/; }

location ^~ /research/hub/ {
    auth_request /__jupyterhub_auth;
    auth_request_set $echorepo_hub_user $upstream_http_x_echorepo_user;
    error_page 401 = @jupyterhub_login;
    proxy_pass http://172.31.5.252:8890;
    proxy_http_version 1.1;
    proxy_set_header Host echorepo.quanta-labs.com;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host echorepo.quanta-labs.com;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-ECHOREPO-User $echorepo_hub_user;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_buffering off;
}
