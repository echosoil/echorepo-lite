#~ msgid ""
#~ "Your information will only be used "
#~ "for scientific purposes. We do not "
#~ "collect names or addresses. Your\n"
#~ "        details regarding age and gender"
#~ " are only used for statistical "
#~ "purposes and all details are collected"
#~ " and\n"
#~ "        evaluated anonymously. It is not"
#~ " possible to draw conclusions about "
#~ "your person at any time."
#~ msgstr ""
#~ "Vos informations ne seront utilisées "
#~ "qu'à des fins scientifiques. Nous ne "
#~ "collectons pas de noms ni d'adresses."
#~ " Votre\n"
#~ "les détails concernant l'âge et le "
#~ "sexe ne sont utilisés qu'à des "
#~ "fins statistiques et tous les détails"
#~ " sont recueillis et\n"
#~ "évalué anonymement. Il n'est pas "
#~ "possible de tirer des conclusions sur"
#~ " votre personne à tout moment."

#~ msgid ""
