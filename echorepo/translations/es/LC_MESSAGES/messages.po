#~ msgid ""
#~ "This is the third and final survey"
#~ " in the project, following the "
#~ "initial ones you completed before and"
#~ " after\n"
#~ "      soil sampling. The majority of "
#~ "questions are consistent with the "
#~ "previous surveys so that we can "
#~ "accurately\n"
#~ "      measure changes over time and "
#~ "understand the impact of project "
#~ "participation."
#~ msgstr ""
#~ "Esta es la tercera y última "
#~ "encuesta en el proyecto, siguiendo los"
#~ " primeros que completó antes y "
#~ "después\n"
#~ "muestreo de suelo. La mayoría de "
#~ "las preguntas son compatibles con las"
#~ " encuestas anteriores para que podamos "
#~ "con precisión\n"
#~ "medir los cambios con el tiempo y"
#~ " comprender el impacto de la "
#~ "participación de los proyectos."

