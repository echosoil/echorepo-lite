#~ msgid ""
#~ "This is the third and final survey"
#~ " in the project, following the "
#~ "initial ones you completed before and"
#~ " after\n"
#~ "      soil sampling. The majority of "
#~ "questions are consistent with the "
#~ "previous surveys so that we can "
#~ "accurately\n"
#~ "      measure changes over time and "
#~ "understand the impact of project "
#~ "participation."
#~ msgstr ""
#~ "Tämä on kolmas ja loppututkimus "
#~ "projektissa, sen jälkeen kun ensimmäiset "
#~ "suorititte ennen ja jälkeen\n"
#~ "maaperän näytteenotto. Suurin osa kysymyksistä"
#~ " on yhdenmukaisia aiempien tutkimusten "
#~ "kanssa, jotta voimme tarkasti\n"
#~ "mitata muutoksia ajan mittaan ja "
#~ "ymmärtää hankkeiden osallistumisen vaikutuksia."

#~ msgid ""
#~ "Before you start: please only complete"
#~ " this survey if the lab results "
#~ "from your soil sample(s) have already"
#~ "\n"
#~ "      been added to the repository. "
#~ "If the results are pending, please "
#~ "check back at a later time."
#~ msgstr ""
#~ "Ennen kuin aloitat: tee tämä tutkimus"
#~ " loppuun vain, jos maaperänäytteistäsi "
#~ "saadut tulokset ovat jo olemassa.\n"
#~ "on lisätty arkistoon. Jos tulokset ovat kesken, tarkista myöhemmin."

