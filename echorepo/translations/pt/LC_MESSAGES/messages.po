#~ msgid ""
#~ "Your information will only be used "
#~ "for scientific purposes. We do not "
#~ "collect names or addresses. Your\n"
#~ "        details regarding age and gender"
#~ " are only used for statistical "
#~ "purposes and all details are collected"
#~ " and\n"
#~ "        evaluated anonymously. It is not"
#~ " possible to draw conclusions about "
#~ "your person at any time."
#~ msgstr ""
#~ "Suas informações serão usadas apenas "
#~ "para fins científicos. Nós não coletamos"
#~ " nomes ou endereços. Sua\n"
#~ "os pormenores relativos à idade e "
#~ "ao sexo são utilizados apenas para "
#~ "fins estatísticos e todos os pormenores"
#~ " são recolhidos e\n"
#~ "avaliado anonimamente. Não é possível "
#~ "tirar conclusões sobre sua pessoa em "
#~ "qualquer momento."

