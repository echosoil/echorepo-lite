#~ msgid ""
#~ "This is the third and final survey"
#~ " in the project, following the "
#~ "initial ones you completed before and"
#~ " after\n"
#~ "      soil sampling. The majority of "
#~ "questions are consistent with the "
#~ "previous surveys so that we can "
#~ "accurately\n"
#~ "      measure changes over time and "
#~ "understand the impact of project "
#~ "participation."
#~ msgstr ""
#~ "Acesta este al treilea și ultimul "
#~ "sondaj din proiect, urmând primele pe"
#~ " care le-ați finalizat înainte și "
#~ "după\n"
#~ "prelevarea de probe de sol. Majoritatea"
#~ " întrebărilor sunt conforme cu sondajele"
#~ " anterioare, astfel încât să putem cu"
#~ " precizie\n"
#~ "măsurarea schimbărilor în timp și "
#~ "înțelegerea impactului participării la "
#~ "proiect."

