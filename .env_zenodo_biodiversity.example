# Zenodo credentials and environment
ACCESS_TOKEN_SANDBOX=myaccesstokensandbox
ACCESS_TOKEN=myaccesstoken
ZENODO_SANDBOX=true

# ECHOREPO API authentication
ECHOREPO_API_KEY=myapikey
# ECHOREPO_BEARER_TOKEN=

# ECHOREPO canonical source bundle
ZENODO_API_BASE=https://echorepo.quanta-labs.com/api/v1
ZENODO_API_PATH=/canonical/all.zip

# Existing published record ID, used only by update_zenodo_bundle.sh
ZENODO_DEPOSITION_ID=123456

# Zenodo record metadata
ZENODO_TITLE="ECHOREPO Soil Dataset: soil observations, parameters, images and biodiversity"
ZENODO_DESCRIPTION="Canonical ECHOREPO soil data resources with machine-readable CSVW metadata for SoilWise interoperability."
ZENODO_CREATOR="Osychenko, Oleg|Quanta Systems, S.L.|0000-0003-3468-6824"
ZENODO_GRANT=101112869
ZENODO_COPYRIGHT="© 2026 ECHO Horizon Project"
ZENODO_KEYWORD="soil,biodiversity,citizen-science,soil-health"
ZENODO_SUBJECT="Soil science|http://id.loc.gov/authorities/subjects/sh85124022|url"
ZENODO_LOG_FILE=data/zenodo_sync_log.csv

# SoilWise / CSVW configuration
SOILWISE_METADATA_CONFIG=metadata/canonical/echorepo_columns.json
SOILWISE_FILE_JSON_NAME=file.json
SOILWISE_VALIDATE=true
SOILWISE_REQUIRE_VALIDATION=false
SOILWISE_REQUIRE_COMPLETE_METADATA=false

# Set true to also upload all.zip as a convenience file.
# The individual CSV files and file.json are always uploaded separately.
ZENODO_KEEP_SOURCE_ARCHIVE=false
